<?xml version="1.0" encoding="UTF-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainscreen"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:context=".MainActivity">

    <cgeo.geocaching.wherigo.WherigoInfoBarView
        android:id="@+id/wherigo_info_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- search field with geocode/keyword suggestions, replaces the search icon in the toolbar -->
    <androidx.appcompat.widget.SearchView
        android:id="@+id/search_pill"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_below="@id/info_notloggedin"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/search_pill_background"
        android:paddingStart="4dp"
        app:iconifiedByDefault="false"
        app:queryBackground="@android:color/transparent"
        app:queryHint="@string/search_bar_hint" />

    <!-- position card -->
    <LinearLayout
        android:id="@+id/location_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/search_pill"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/section_card"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_your_position"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="@color/md_primary" />

        <cgeo.geocaching.ui.LocationStatusView
            android:id="@+id/location_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- what is stored on the device -->
    <LinearLayout
        android:id="@+id/storage_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/location_area"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/section_card"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_storage"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="@color/md_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/storage_caches"
                layout="@layout/cachedetail_stat_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp" />

            <include
                android:id="@+id/storage_lists"
                layout="@layout/cachedetail_stat_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp" />

            <include
                android:id="@+id/storage_offline_logs"
                layout="@layout/cachedetail_stat_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/storage_database"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/colorTextHint"
            tools:text="Database: 208 KB" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/status"
        android:name="cgeo.geocaching.StatusFragment"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dip"
        android:layout_below="@id/wherigo_info_bar"
        tools:layout="@layout/status" />

    <LinearLayout
        android:id="@+id/reminders"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dip"
        android:layout_below="@id/status"
        android:orientation="vertical">

        <include
            android:id="@+id/mapupdate"
            layout="@layout/mainactivity_action_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <include
            android:id="@+id/tilesupdate"
            layout="@layout/mainactivity_action_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <include
            android:id="@+id/mcupdate"
            layout="@layout/mainactivity_action_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <include
            android:id="@+id/missingLocationPermission"
            layout="@layout/mainactivity_action_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/info_notloggedin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dip"
        android:layout_marginTop="8dp"
        android:layout_below="@id/reminders"
        android:background="@drawable/helper_bcg"
        android:minHeight="64dp"
        android:padding="8dp"
        android:visibility="gone">

        <include
            layout="@layout/attribute_image"
            android:id="@+id/info_notloggedin_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_margin="4dip" />

        <TextView
            android:id="@+id/info_notloggedin_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="8dp"
            android:layout_toRightOf="@id/info_notloggedin_icon"
            android:gravity="start|center_vertical"
            android:text="@string/warn_notloggedin_short"
            android:textColor="@color/colorTextMainInfo"
            android:textIsSelectable="false"
            android:textSize="@dimen/textSize_detailsPrimary" />
    </RelativeLayout>

    <ListView
        android:id="@+id/connectorstatus_area"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/quicklaunchitems"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:divider="@null"
        android:orientation="vertical"
        android:scrollbars="none"
        tools:listitem="@layout/main_activity_connectorstatus" />

    <LinearLayout
        android:id="@+id/quicklaunchitems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/storage_card"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <!-- will be filled dynamically with quick launch buttons -->

    </LinearLayout>

</RelativeLayout>
