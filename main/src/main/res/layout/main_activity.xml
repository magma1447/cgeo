<?xml version="1.0" encoding="UTF-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainscreen"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    tools:context=".MainActivity">

    <cgeo.geocaching.wherigo.WherigoInfoBarView
        android:id="@+id/wherigo_info_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- search pill: opens the search page -->
    <LinearLayout
        android:id="@+id/search_pill"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_below="@id/wherigo_info_bar"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/search_pill_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_menu_search"
            app:tint="@color/md_on_surface_variant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/search_bar_hint"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="@color/md_on_surface_variant" />
    </LinearLayout>

    <!-- position card -->
    <LinearLayout
        android:id="@+id/location_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/search_pill"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/section_card"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_your_position"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="@color/md_primary" />

        <cgeo.geocaching.ui.LocationStatusView
            android:id="@+id/location_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/offline_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/stat_tile"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="@color/colorText"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="1234 caches stored offline" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/status"
        android:name="cgeo.geocaching.StatusFragment"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dip"
        android:layout_marginTop="16dp"
        android:layout_below="@id/location_area"
        tools:layout="@layout/status" />

    <LinearLayout
        android:id="@+id/reminders"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dip"
        android:layout_marginTop="16dp"
        android:layout_below="@id/status"
        android:orientation="vertical">

        <include
            android:id="@+id/mapupdate"
            layout="@layout/mainactivity_action_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <include
            android:id="@+id/tilesupdate"
            layout="@layout/mainactivity_action_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <include
            android:id="@+id/mcupdate"
            layout="@layout/mainactivity_action_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <include
            android:id="@+id/missingLocationPermission"
            layout="@layout/mainactivity_action_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/info_notloggedin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dip"
        android:layout_marginTop="16dip"
        android:layout_below="@id/reminders"
        android:background="@drawable/helper_bcg"
        android:visibility="gone">

        <include
            layout="@layout/attribute_image"
            android:id="@+id/info_notloggedin_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_margin="4dip" />

        <TextView
            android:id="@+id/info_notloggedin_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="8dp"
            android:layout_toRightOf="@id/info_notloggedin_icon"
            android:gravity="center"
            android:text="@string/warn_notloggedin_short"
            android:textColor="@color/colorTextMainInfo"
            android:textIsSelectable="false"
            android:textSize="@dimen/textSize_detailsPrimary" />
    </RelativeLayout>

    <ListView
        android:id="@+id/connectorstatus_area"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/quicklaunchitems"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:divider="@null"
        android:orientation="vertical"
        android:scrollbars="none"
        tools:listitem="@layout/main_activity_connectorstatus" />

    <LinearLayout
        android:id="@+id/quicklaunchitems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/info_notloggedin"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <!-- will be filled dynamically with quick launch buttons -->

    </LinearLayout>

</RelativeLayout>
