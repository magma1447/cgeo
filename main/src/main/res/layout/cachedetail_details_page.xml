<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/details_scroll"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:scrollbars="none"
    tools:context=".CacheDetailActivity$DetailsViewCreator">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="16dp" >

        <include
            android:id="@+id/hero"
            layout="@layout/cachedetail_hero" />

        <!-- Details list -->

        <LinearLayout
            android:id="@+id/details_list"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/section_card"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:orientation="vertical" >
        </LinearLayout>

        <!-- Attributes box -->

        <LinearLayout
            android:id="@+id/attributes_box"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/section_card"
            android:paddingVertical="12dp"
            android:paddingHorizontal="6dp"
            android:orientation="vertical" >

            <cgeo.geocaching.ui.WrappingGridView
                android:id="@+id/attributes_grid"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:columnWidth="32dip"
                android:horizontalSpacing="2dip"
                android:numColumns="auto_fit"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:scrollbars="none"
                android:stretchMode="none"
                android:verticalSpacing="2dip" />

            <TextView
                android:id="@+id/attributes_text"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:linksClickable="true"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:textIsSelectable="false"
                android:textSize="@dimen/textSize_detailsSecondary"
                android:textColor="@color/colorText"
                tools:text="attribute 1\nattribute 2\nattribute 3"/>
        </LinearLayout>

        <!-- Offline box and the other per-cache actions, grouped in one card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/section_card"
            android:paddingHorizontal="8dp"
            android:paddingVertical="12dp"
            android:orientation="vertical">

        <include layout="@layout/cache_offlinebox" />

        <!-- Named filter box -->
        <include layout="@layout/cache_namedfilterbox" />

        <!-- Watchlist box -->
        <LinearLayout
            android:id="@+id/watchlist_box"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" >

                <TextView
                    android:id="@+id/watchlist_text"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:layout_gravity="left"
                    android:layout_marginLeft="6dip"
                    android:layout_marginRight="60dip"
                    android:paddingRight="3dip"
                    android:textSize="@dimen/textSize_detailsSecondary"
                    android:textColor="@color/colorText"
                    tools:text="The cache may or may not be on your watch list."
                    android:textIsSelectable="false" />

                <Button
                    android:id="@+id/add_to_watchlist"
                    style="@style/button_icon"
                    android:layout_alignParentRight="true"
                    app:icon="@drawable/ic_menu_watch"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/remove_from_watchlist"
                    style="@style/button_icon"
                    android:layout_alignParentRight="true"
                    app:icon="@drawable/ic_menu_watch_remove"
                    android:visibility="gone" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Internal Wherigo player box -->

        <LinearLayout
            android:id="@+id/wherigo_box"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" >

                <TextView
                    android:id="@+id/wherigo_text"
                    android:text="@string/cache_wherigo_start"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:layout_gravity="left"
                    android:layout_marginLeft="6dip"
                    android:layout_marginRight="100dip"
                    android:paddingRight="3dip"
                    android:textSize="@dimen/textSize_detailsSecondary"
                    android:textColor="@color/colorText"
                    android:textIsSelectable="false" />

                <Button
                    android:id="@+id/play_in_cgeo"
                    android:layout_alignParentRight="true"
                    style="@style/button_icon"
                    app:icon="@drawable/ic_menu_wherigo" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Chirp box -->

        <LinearLayout
            android:id="@+id/chirp_box"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" >

                <TextView
                    android:id="@+id/chirp_text"
                    android:text="@string/cache_chirpwolf_start"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:layout_gravity="left"
                    android:layout_marginLeft="6dip"
                    android:layout_marginRight="60dip"
                    android:paddingRight="3dip"
                    android:textSize="@dimen/textSize_detailsSecondary"
                    android:textColor="@color/colorText"
                    tools:text="Start Chirp Wolf"
                    android:textIsSelectable="false" />

                <Button
                    android:id="@+id/send_to_chirp"
                    style="@style/button_icon_colored"
                    android:layout_alignParentRight="true"
                    app:icon="@drawable/icon_gc_chirpwolf"
                    android:visibility="visible"
                    tools:visibility="visible"/>
            </RelativeLayout>
        </LinearLayout>

        <!-- Adventure Lab box -->

        <LinearLayout
            android:id="@+id/alc_box"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" >

                <TextView
                    android:id="@+id/alc_text"
                    android:text="@string/cache_alc_start"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:layout_gravity="left"
                    android:layout_marginLeft="6dip"
                    android:layout_marginRight="60dip"
                    android:paddingRight="3dip"
                    android:textSize="@dimen/textSize_detailsSecondary"
                    android:textColor="@color/colorText"
                    tools:text="Start Adventure Lab"
                    android:textIsSelectable="false" />

                <Button
                    android:id="@+id/send_to_alc"
                    style="@style/button_icon_colored"
                    android:layout_alignParentRight="true"
                    app:icon="@drawable/icon_gc_alc"
                    android:visibility="visible"
                    tools:visibility="visible"
                    android:tooltipText="@string/cache_alc_start"/>
            </RelativeLayout>
        </LinearLayout>

        <!-- Favorite points box -->

        <LinearLayout
            android:id="@+id/favpoint_box"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" >

                <TextView
                    android:id="@+id/favpoint_text"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:layout_gravity="left"
                    android:layout_marginLeft="6dip"
                    android:layout_marginRight="60dip"
                    android:paddingRight="3dip"
                    android:textSize="@dimen/textSize_detailsSecondary"
                    android:textColor="@color/colorText"
                    tools:text="Probably not on your favorite list. You may have some fav points remaining."
                    android:textIsSelectable="false" />

                <Button
                    android:id="@+id/add_to_favpoint"
                    style="@style/button_icon"
                    android:layout_alignParentRight="true"
                    app:icon="@drawable/ic_menu_favorite"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/remove_from_favpoint"
                    style="@style/button_icon"
                    android:layout_alignParentRight="true"
                    app:icon="@drawable/ic_menu_favorite_remove"
                    android:visibility="gone" />
            </RelativeLayout>
        </LinearLayout>

        </LinearLayout>

        <!-- License Box -->

        <LinearLayout
            android:id="@+id/license_box"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <cgeo.geocaching.ui.SectionHeader
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:dividerAbove="true"
                android:text="@string/cache_license" />

            <TextView
                android:id="@+id/license"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:linksClickable="true"
                android:padding="3dip"
                android:textSize="@dimen/textSize_detailsSecondary"
                android:textColor="@color/colorText"
                tools:text="some license text"/>
        </LinearLayout>

        <!-- Personal note box, last on the page -->

        <LinearLayout
            android:id="@+id/personalnote_box"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/section_card"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:orientation="vertical">

            <!-- card title, as on the home screen -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/cache_personal_note"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="@color/md_primary" />

            <TextView
                android:id="@+id/personalnote"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:linksClickable="true"
                android:textSize="@dimen/textSize_detailsPrimary"
                android:textColor="@color/colorText"
                tools:text="Personal note text\nline 2\nline 3" />

            <View style="@style/flat_separator_horizontal_heading_line"
                android:id="@+id/personalnote_button_separator" />

            <Button style="@style/button_full"
                android:id="@+id/personalnote_vars_out_of_sync"
                android:layout_marginHorizontal="3dp"
                tools:text="Warning: variables are out of sync"
                tools:visibility="visible"
                android:visibility="gone"/>

            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:gravity="right"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/upload_personalnote"
                        style="@style/button_icon"
                        android:tooltipText="@string/cache_personal_note_upload"
                        app:icon="@drawable/ic_menu_upload" />

                    <Button
                        android:id="@+id/edit_personalnote"
                        style="@style/button_icon"
                        android:tooltipText="@string/cache_personal_note_edit"
                        app:icon="@drawable/ic_menu_edit" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:gravity="left"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/storewaypoints_personalnote"
                        style="@style/button_icon"
                        android:tooltipText="@string/cache_personal_note_storewaypoints"
                        app:icon="@drawable/ic_menu_waypoint_sync" />

                    <Button
                        android:id="@+id/deleteewaypoints_personalnote"
                        style="@style/button_icon"
                        android:tooltipText="@string/cache_personal_note_removewaypoints"
                        app:icon="@drawable/ic_menu_waypoint_delete" />

                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>
