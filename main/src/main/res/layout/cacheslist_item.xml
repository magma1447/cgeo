<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/one_cache"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/list_card_background"
    tools:context=".ui.CacheListAdapter">

    <!-- "found" marker, vertical green/red line -->
    <ImageView
        android:id="@+id/log_status_mark"
        android:layout_width="4dip"
        android:layout_height="match_parent"
        android:layout_marginRight="4dip"
        android:layout_marginTop="5dip"
        android:layout_marginBottom="5dip"
        android:scaleType="centerCrop"
        android:gravity="left|center_vertical"
        android:src="@drawable/mark_transparent"
        android:visibility="visible"
        tools:visibility="visible" />

    <!-- selection mode checkbox -->
    <CheckBox
        android:id="@+id/checkbox"
        android:layout_width="wrap_content"
        android:layout_height="fill_parent"
        android:layout_gravity="left"
        android:gravity="left|center_horizontal"
        android:paddingRight="5dip"
        android:visibility="gone"
        tools:visibility="visible"/>

    <!-- cache icon -->
    <ImageView
        android:id="@+id/text_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="5dip"
        android:layout_marginRight="4dip"
        android:scaleType="fitXY"
        android:gravity="left|top"
        android:visibility="visible"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_weight="1">

        <!-- cache name: one line; dragging it sideways scrolls all names in the list together
             (see CacheListAdapter), the faded edge shows there is more -->
        <TextView
            android:id="@+id/text"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:paddingTop="5dip"
            android:singleLine="true"
            android:ellipsize="none"
            android:requiresFadingEdge="horizontal"
            android:fadingEdgeLength="32dp"
            android:textIsSelectable="false"
            android:textSize="@dimen/textSize_listsPrimary"
            android:textColor="@color/colorText_listsPrimary"
            android:fontFamily="sans-serif-medium"
            tools:text="name" />

        <!-- configured info items, then favorites and trackables -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="left"
                android:ellipsize="end"
                android:paddingBottom="5dip"
                android:paddingRight="6dip"
                android:textIsSelectable="false"
                android:textSize="@dimen/textSize_listsSecondary"
                android:textColor="@color/colorText_listsSecondary"
                tools:text="GC12345 · D 1.5 · T 2.0 · Regular" />

            <TextView
                android:id="@+id/favorite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="5dip"
                android:drawablePadding="3dp"
                android:maxLines="1"
                android:textIsSelectable="false"
                android:textSize="@dimen/textSize_listsSecondary"
                android:textColor="@color/colorText_listsSecondary"
                app:drawableStartCompat="@drawable/ic_heart_small"
                tools:text="87 (34%)" />

            <TextView
                android:id="@+id/inventory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingBottom="5dip"
                android:drawablePadding="-10sp"
                android:maxLines="1"
                android:text=""
                android:textIsSelectable="false"
                android:textSize="@dimen/textSize_listsSecondary"
                android:textColor="@color/colorText_listsPrimary"
                android:textStyle="bold"
                app:drawableLeftCompat="@drawable/trackable_all"
                tools:text="12" />
        </LinearLayout>
    </LinearLayout>

    <!-- distance and direction, spanning both rows -->
    <RelativeLayout
        android:layout_width="72dip"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_gravity="center_vertical">

    <cgeo.geocaching.ui.DistanceView
        android:id="@+id/distance"
        android:layout_width="72dip"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_gravity="center"
        android:ellipsize="end"
        android:gravity="center"
        android:lines="1"
        android:scrollHorizontally="true"
        android:textSize="@dimen/textSize_listsSecondary"
        android:textColor="@color/colorText_listsPrimary"
        android:maxLines="1" /><!-- explicitly use default text color here -->

    <cgeo.geocaching.ui.CompassMiniView
        android:id="@+id/direction"
        android:layout_width="72dip"
        android:layout_height="28dip"
        android:layout_centerHorizontal="true"
        android:layout_gravity="center"
        android:layout_below="@id/distance"
        android:gravity="center"
        android:minHeight="28px"
        android:minWidth="28px"
        android:visibility="gone"
        app:skin="?compass"
        tools:ignore="PxUsage" />

    <ImageView
        android:id="@+id/dirimg"
        android:layout_width="72dip"
        android:layout_height="28px"
        android:layout_centerHorizontal="true"
        android:layout_gravity="center"
        android:layout_below="@id/distance"
        android:gravity="center"
        android:minHeight="28px"
        android:minWidth="28px"
        android:src="@null"
        android:visibility="gone"
        tools:ignore="PxUsage" />
    </RelativeLayout>

</LinearLayout>
