<?xml version="1.0" encoding="utf-8"?>
<!-- header of the cache details page: who/what the cache is, plus its key numbers -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/hero"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingTop="12dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/hero_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="14dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            tools:src="@drawable/type_traditional" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hero_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="3"
                android:ellipsize="end"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                android:textColor="@color/colorText"
                tools:text="Ledge above the old mill" />

            <TextView
                android:id="@+id/hero_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/colorTextHint"
                tools:text="GC7XYZ1" />
        </LinearLayout>
    </LinearLayout>

    <!-- live distance and direction; opens the compass -->
    <LinearLayout
        android:id="@+id/hero_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/search_pill_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <cgeo.geocaching.ui.CompassMiniView
            android:id="@+id/hero_compass"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/hero_compass_background"
            app:skin="?compass" />

        <TextView
            android:id="@+id/hero_distance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
            android:textColor="@color/colorText"
            tools:text="491 ft" />

        <!-- default navigation (also on tapping the card), then the choice of navigation apps -->
        <ImageButton
            android:id="@+id/hero_navigation_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cache_menu_navigate"
            android:src="@drawable/ic_menu_compass"
            app:tint="@color/md_primary" />

        <ImageButton
            android:id="@+id/hero_navigation_choose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cache_menu_navigate"
            android:src="@drawable/ic_menu_navigate"
            app:tint="@color/md_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <include
            android:id="@+id/stat_difficulty_terrain"
            layout="@layout/cachedetail_stat_tile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp" />

        <include
            android:id="@+id/stat_size"
            layout="@layout/cachedetail_stat_tile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp" />

        <include
            android:id="@+id/stat_favorites"
            layout="@layout/cachedetail_stat_tile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
