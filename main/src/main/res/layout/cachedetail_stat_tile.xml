<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:background="@drawable/stat_tile"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="4dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/stat_value"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:gravity="center"
        android:maxLines="1"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="11sp"
        app:autoSizeMaxTextSize="22sp"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textColor="@color/colorText"
        android:fontFeatureSettings="tnum"
        tools:text="1.5" />

    <!-- difficulty and terrain as stars instead of the value (only the D/T tile, toggled by tapping it) -->
    <LinearLayout
        android:id="@+id/stat_stars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="@string/cache_difficulty_short"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="@color/colorTextHint" />

            <RatingBar
                android:id="@+id/stat_stars_difficulty"
                style="@style/cacheRatingBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                tools:rating="1.5" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="@string/cache_terrain_short"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="@color/colorTextHint" />

            <RatingBar
                android:id="@+id/stat_stars_terrain"
                style="@style/cacheRatingBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:numStars="5"
                tools:rating="2" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/stat_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
        android:textColor="@color/colorTextHint"
        tools:text="Difficulty" />
</LinearLayout>
